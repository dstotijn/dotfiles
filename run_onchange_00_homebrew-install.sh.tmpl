{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

# Brewfile hash: {{ include "Brewfile" | sha256sum }}

brew bundle --file {{ joinPath .chezmoi.sourceDir "Brewfile" | quote }} --no-upgrade

# Set fish as default shell
FISH_PATH="$(brew --prefix)/bin/fish"
if ! grep -qxF "$FISH_PATH" /etc/shells; then
    echo "$FISH_PATH" | sudo tee -a /etc/shells
fi
# Check the account's login shell, not $SHELL, which agents and other parent
# processes may set to something else.
if [ "$(dscl . -read ~ UserShell | awk '{print $2}')" != "$FISH_PATH" ]; then
    chsh -s "$FISH_PATH"
fi
{{ end -}}
