{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/scripts/hindsight-recall-hook.sh' codex",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash '{{ .chezmoi.homeDir }}/.local/bin/herdr-agent-context'",
            "timeout": 5,
            "type": "command"
          }
        ]
      }{{ template "rex-session-start" (dict
        "path" (joinPath .chezmoi.homeDir ".codex/hooks.json")
        "agent" "codex") }}
    ]
  }
}
