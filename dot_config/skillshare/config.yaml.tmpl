# yaml-language-server: $schema=https://raw.githubusercontent.com/runkids/skillshare/main/schemas/config.schema.json
source: ~/.local/share/skillshare/skills
mode: merge
targets:
  claude:
    skills:
      path: ~/.claude/skills
      exclude:
        - anthropic__skill-creator
        - anthropic__pdf
  codex:
    skills:
      path: ~/.codex/skills
  omp:
    skills:
      path: ~/.omp/agent/skills
  opencode:
    skills:
      path: ~/.config/opencode/skills
  pi:
    skills:
      path: ~/.pi/agent/skills
ignore:
  - '**/.DS_Store'
  - '**/.git/**'
audit:
  block_threshold: CRITICAL
mcp:
  targets: [claude, codex, opencode]
  servers:
    browse:
      command: {{ .chezmoi.homeDir }}/.local/bin/browse
      args: [mcp]
      env:
        OPENCODE_BROWSER_ALLOW_FOREGROUND: "0"
