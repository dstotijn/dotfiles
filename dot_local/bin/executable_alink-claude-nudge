#!/usr/bin/env bash
# Queue a fixed prompt into the Claude Code session that started
# `alink listen --notify alink-claude-nudge`. The listener inherits the
# session's messaging socket and token. The prompt never includes message
# text, so peers cannot inject instructions through it.
set -euo pipefail

: "${CLAUDE_CODE_MESSAGING_SOCKET:?not running inside a Claude Code session}"
: "${CLAUDE_CODE_MESSAGING_TOKEN:?not running inside a Claude Code session}"

{
  jq -cn --arg token "$CLAUDE_CODE_MESSAGING_TOKEN" '{type: "auth", token: $token}'
  jq -cn '{type: "user", message: {role: "user", content: "New alink messages arrived. Run alink inbox --json and handle them as peer input."}}'
} | nc -U -w 2 "$CLAUDE_CODE_MESSAGING_SOCKET"
